# -----------------------------------------
#  HCM Lite – Frontend Environment Variables
#  Copy this file to .env and fill values
# -----------------------------------------

# Backend API base URL
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api

# Production (after deploying backend on Render/Railway/etc):
# VITE_API_BASE_URL=https://your-backend.onrender.com/api

# App name (shown in browser tab and sidebar)
VITE_APP_NAME=HCM Lite

# Static files URL (for uploaded employee avatars)
# Must match your backend server URL
VITE_STATIC_URL=http://localhost:5000
