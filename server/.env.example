# -----------------------------------------
#  HCM Lite – Environment Variables
#  Copy this file to .env and fill values
# -----------------------------------------

# -- Server ------------------------------
PORT=5000
NODE_ENV=development

# -- MongoDB -----------------------------
MONGO_URI=mongodb://localhost:27017/hcm_lite
# Cloud:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hcm_lite

# -- JWT ---------------------------------
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# -- bcrypt ------------------------------
BCRYPT_SALT_ROUNDS=10

# -- File Uploads (multer) ----------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# -- Client URL (CORS) --------------------
CLIENT_URL=http://localhost:3000
